{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "Node.js Express backend for portfolio website",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migrate:up": "db-migrate up --env dev",
    "migrate:down": "db-migrate down --env dev",
    "migrate:reset": "db-migrate reset --env dev",
    "migrate:status": "db-migrate status --env dev",
    "migrate:create": "db-migrate create --env dev"
  },
  "keywords": [
    "portfolio",
    "express",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pg": "^8.17.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.2",
    "nodemon": "^3.1.10"
